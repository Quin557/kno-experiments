# Copy this file to configs/data_paths.env on the server and edit the paths.
# Do not commit configs/data_paths.env.

DATA_ROOT=/path/to/large/am_fno_data

# CFD-1D / CFD-2D HDF5 files, relative to DATA_ROOT or absolute.
CFD1D_FILE=1D_CFD_Rand_Eta0.01_Zeta0.01_periodic_Train.hdf5
CFD2D_FILE=2D_CFD_Rand_M0.1_Eta0.01_Zeta0.01_periodic_128_Train.hdf5

# NS-2D MAT files. Use the same file as train/test when the split is internal.
NS2D_V1E3=ns_V1e-3_N5000_T50.mat
NS2D_V1E4=ns_V1e-4_N10000_T30.mat

# Optional external code locations on the server.
KOOPMANLAB_ROOT=external/KoopmanLab
AMFNO_REPRO_ROOT=external/am_fno_repro
