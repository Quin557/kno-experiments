# Keep lightweight experiment records in git when copied here deliberately.
!results/
!results/.gitkeep
!reports/
!reports/.gitkeep
!experiments/
!experiments/.gitkeep
!scripts/
!scripts/.gitkeep

# Local private config
configs/data_paths.env
*.local.env

# Third-party source trees are cloned locally; do not vendor nested git repos.
external/*
!external/README.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
